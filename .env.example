DATABASE_URL=
# Mode de secours réservé aux tests Render lorsque DATABASE_URL n'est pas disponible.
# Ne pas utiliser comme stockage de production durable.
DATABASE_MODE=
PGLITE_DATA_DIR=/tmp/mboteroom-pglite-test
PGLITE_INITIAL_MEMORY_MB=64
ADMIN_EMAILS=
MBOTE_AUTH_BASE_URL=https://mbote-backend.onrender.com
MBOTE_AUTH_CLIENT_ID=mbote-room
MBOTE_AUTH_CLIENT_SECRET=
MBOTE_AUTH_AUTHORIZE_URL=
MBOTE_AUTH_TOKEN_URL=
MBOTE_AUTH_PROFILE_URL=https://mbote-backend.onrender.com/api/users/me
MBOTE_AUTH_LOGIN_URL=https://mbote-backend.onrender.com/api/auth/login
MBOTE_AUTH_REDIRECT_URI=
MBOTE_ROOM_APP_URL=
MBOTE_ROOM_ALLOWED_ORIGINS=
# Session web sécurisée. Laisser le domaine vide pour un cookie lié à l'hôte courant.
MBOTE_ROOM_SESSION_COOKIE=mbote_room_session
MBOTE_ROOM_COOKIE_SAMESITE=lax
MBOTE_ROOM_COOKIE_DOMAIN=
# Active le bouton "Continuer avec MBoté" avec le fournisseur OAuth MBoté.
# Exemple local : MBOTE_AUTH_BASE_URL=http://localhost:3000
# Le même client et cette redirect URI doivent être autorisés côté MBoté.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=30000
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_TIMEOUT_MS=30000
# Optionnel: URL compatible OpenAI/Groq pour tests ou proxy interne.
GROQ_TRANSCRIPTION_URL=
CAPTION_CHUNK_SECONDS=10
RESEND_API_KEY=
MEETING_INVITE_FROM=MBotéRoom <reunions@votre-domaine.com>
VITE_API_URL=
VITE_SOCKET_URL=
# TURN serveur recommandé: identifiants temporaires générés par /api/rtc/config.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
# Compatibilité locale uniquement; éviter des credentials TURN statiques dans le frontend en production.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Media topology: auto prefers LiveKit when fully configured, otherwise mesh.
MEDIA_TRANSPORT=auto
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=900
LIVEKIT_EGRESS_ENABLED=false

# LiveKit Egress server recording. Use S3-compatible storage (AWS, MinIO, R2, etc.)
LIVEKIT_EGRESS_USE_SERVER_DEFAULT_STORAGE=false
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_REGION=
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET_KEY=
LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true
