DATABASE_URL=
# Production doit utiliser PostgreSQL persistant.
# pgmem-test est réservé aux tests explicites/CI.
DATABASE_MODE=postgres
ADMIN_EMAILS=
MBOTE_AUTH_BASE_URL=https://mbote-backend.onrender.com
MBOTE_AUTH_CLIENT_ID=mbote-room
MBOTE_AUTH_CLIENT_SECRET=
MBOTE_AUTH_AUTHORIZE_URL=
MBOTE_AUTH_TOKEN_URL=
MBOTE_AUTH_PROFILE_URL=https://mbote-backend.onrender.com/api/users/me
MBOTE_AUTH_LOGIN_URL=https://mbote-backend.onrender.com/api/auth/login
MBOTE_AUTH_REDIRECT_URI=
MBOTE_ROOM_APP_URL=
MBOTE_ROOM_ALLOWED_ORIGINS=
# Session web sécurisée. Laisser le domaine vide pour un cookie lié à l'hôte courant.
MBOTE_ROOM_SESSION_COOKIE=mbote_room_session
MBOTE_ROOM_COOKIE_SAMESITE=lax
MBOTE_ROOM_COOKIE_DOMAIN=
# Déconnexion automatique après 5 minutes sans interaction utilisateur.
MBOTE_ROOM_IDLE_TIMEOUT_MS=300000
# Active le bouton "Continuer avec MBoté" avec le fournisseur OAuth MBoté.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_TIMEOUT_MS=30000
GROQ_TRANSCRIPTION_URL=
CAPTION_CHUNK_SECONDS=10
# E-mail transactionnel. MBotéRoom privilégie le relais sécurisé du backend MBoté,
# qui détient la clé Brevo. BREVO_API_KEY reste un secours direct optionnel.
MBOTE_MAIL_RELAY_URL=https://mbote-mobile-backend.onrender.com/api/v1/internal/mbote-room/email
MBOTE_ROOM_MAIL_SECRET=
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=contacts@loukatech.com
BREVO_SENDER_NAME=MBotéRoom
EMAIL_REPLY_TO=nzotocare@gmail.com
EMAIL_SEND_TIMEOUT_MS=12000
RESEND_API_KEY=
MEETING_INVITE_FROM=MBotéRoom <reunions@votre-domaine.com>
VITE_API_URL=
VITE_SOCKET_URL=

# ICE/TURN.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Mode TURN à secret partagé avec credentials temporaires.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
# Mode TURN statique côté serveur (ex. Metered). Ne jamais préfixer ces variables par VITE_.
MBOTEROOM_TURN_URL=
MBOTEROOM_TURN_USERNAME=
MBOTEROOM_TURN_CREDENTIAL=
# Media topology: auto prefers LiveKit when fully configured, otherwise mesh.
MEDIA_TRANSPORT=auto
MBOTE_ROOM_REQUIRE_LIVEKIT=false
MBOTE_ROOM_REQUIRE_SERVER_RECORDING=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=900
LIVEKIT_EGRESS_ENABLED=false

# LiveKit Egress server recording. Use S3-compatible storage (AWS, MinIO, R2, etc.)
LIVEKIT_EGRESS_USE_SERVER_DEFAULT_STORAGE=false
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_REGION=
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET_KEY=
LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true

# Web Push / PWA notifications
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:contacts@loukatech.com"
